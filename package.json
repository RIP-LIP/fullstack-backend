{
  "name": "fullstack-backend",
  "version": "0.0.0",
  "private": true,
  "description": "订单/库存领域后端，Node + Express + TypeScript，配套 fullstack-handbook 的深挖章节",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @fullstack/api",
    "test": "tsx --test apps/api/test/api.test.ts",
    "typecheck": "tsc --build apps/api packages/shared",
    "verify": "npm run typecheck && npm run test",
    "verify:tag": "node scripts/verify-tag.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT"
}
