# 复制成 .env 后按需改。只列当前代码真的读到的键。
#
# 两套加载规则不一样，别混：
# - docker compose 会自动读同目录的 .env 做变量替换，所以 POSTGRES_PASSWORD
#   写在这里就生效，不用手动传。
# - 后端代码不会自动加载 .env，要给 PORT 传值得自己带进启动命令：
#   PowerShell:  $env:PORT = 3002; npm run dev:api
#   bash:        PORT=3002 npm run dev:api

# 后端端口。默认 3002，fullstack-todo-app 占着 3001。
PORT=3002

# docker-compose.yml 里的 Postgres 密码
POSTGRES_PASSWORD=postgres
